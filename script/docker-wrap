#!/usr/bin/env bash

tmp=$(mktemp -t docker_XXXXX)

kill_docker() {
  sudo kill $pid
}

rm -rf $tmp
mkdir -p $tmp
echo "starting docker in $tmp"

OLD_DOCKER_HOST=${DOCKER_HOST}
export DOCKER_HOST=unix://${tmp}/docker.sock 
trap kill_docker EXIT
sudo docker -d -g ${tmp}/lib -p ${tmp}/docker.pid -H ${DOCKER_HOST} -e lxc >$tmp/docker.log 2>&1 &
while [ ! -f ${tmp}/docker.pid ]; do sleep 1; done
pid=$(cat ${tmp}/docker.pid)

$*

export DOCKER_HOST=${OLD_DOCKER_HOST}
