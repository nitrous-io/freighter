#!/usr/bin/env bash

tmp=$(mktemp -t docker_XXXXX)

cleanup() {
  docker stop $cid && docker rm $cid
}

die() {
  echo $*
  exit 1
}

version=$(docker version | grep 'Client version' | cut -d':' -f2 | tr -d ' ')
docker pull ddollar/dind:$version >/dev/null 2>&1 || die "image ddollar/dind:$version does not exist"

# ddollar/dind is built from https://github.com/jpetazzo/dind
cid=$(docker run --privileged -d -p 4444 -e PORT=4444 ddollar/dind)
host=$(docker port $cid 4444/tcp)

trap cleanup EXIT

OLD_DOCKER_HOST=${DOCKER_HOST}
export DOCKER_HOST=tcp://$host

$*

export DOCKER_HOST=${OLD_DOCKER_HOST}
